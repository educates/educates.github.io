---
// A small line icon in the current text color, sized by the font size.
// Decorative: it is hidden from screen readers, so give its control a label.
export interface Props {
  name:
    | "chevron-down"
    | "external"
    | "menu"
    | "close"
    | "github"
    | "arrow-right"
    | "download";
  class?: string;
}

const { name, class: className } = Astro.props;

const strokes: Record<string, string> = {
  "chevron-down": "M6 9l6 6 6-6",
  external: "M8 16L16 8M10 8h6v6",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6L6 18",
  "arrow-right": "M5 12h14M13 6l6 6-6 6",
  download: "M12 4v11M7 10l5 5 5-5M5 20h14",
};

const github =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z";
---

{name === "github" ? (
  <svg
    class:list={["icon", "icon-filled", className]}
    viewBox="0 0 16 16"
    aria-hidden="true"
    focusable="false"
  >
    <path d={github} />
  </svg>
) : (
  <svg
    class:list={["icon", className]}
    viewBox="0 0 24 24"
    aria-hidden="true"
    focusable="false"
  >
    <path d={strokes[name]} />
  </svg>
)}

<style>
  .icon {
    flex: none;
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .icon-filled {
    fill: currentColor;
    stroke: none;
  }
</style>
