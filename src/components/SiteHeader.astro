---
import { site } from "../site.ts";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/img/logo.svg" alt="" width="30" height="30" />
      {site.name}
    </a>
    <div class="actions">
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .wrap {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
</style>
