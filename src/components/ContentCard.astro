---
// A card for one piece of Content, wherever Content is listed: its cover,
// kind, title, one-line description, date, reading time or length, up to
// two Topics, and for an outside entry its source and the mark of a link
// that opens elsewhere. The whole card is the link.
//
// The cover is drawn by the Cover component as static HTML in the theme's
// colours, or is the entry's own cover image, which does not follow the
// theme.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Cover from "./Cover.tsx";
import Icon from "./Icon.astro";
import type { CoverProps } from "../lib/cover.ts";
import { formatDate, isoDate } from "../lib/posts.ts";

export interface Props {
  /** Where the card leads: a page on the site, or an outside entry's URL. */
  href: string;
  /** The kind of Content, such as "Blog post", "Guide" or "Video". */
  kind: string;
  title: string;
  /** The entry's one-line description. */
  description: string;
  /** When it was published; guides have none. */
  date?: Date;
  /** Its reading time or length, such as "6 min read" or "10:45". */
  length?: string;
  /** The names of its Topics; the card shows the first two. */
  topics?: string[];
  /**
   * For an outside entry, the event, channel or site it comes from. The
   * card names it and marks the link as leading to another site.
   */
  source?: string;
  /** What its generated cover draws. */
  cover: CoverProps;
  /** The entry's own cover image, which replaces the generated cover. */
  coverImage?: ImageMetadata;
  /** The level of the title's heading, below the list's own heading. */
  heading?: "h2" | "h3";
}

const {
  href,
  kind,
  title,
  description,
  date,
  length,
  topics = [],
  source,
  cover,
  coverImage,
  heading: Heading = "h2",
} = Astro.props;
const meta = date !== undefined || length !== undefined;
---

<article class="content-card">
  <div class="cover" aria-hidden="true">
    {coverImage ? (
      <Image src={coverImage} alt="" width={800} height={420} />
    ) : (
      <Cover {...cover} logo="/img/logo.svg" />
    )}
  </div>
  <div class="body">
    <p class="kind">{kind}</p>
    <Heading class="title">
      <a href={href}>
        {title}
        {source && <span class="sr-only">{" (external site)"}</span>}
      </a>
    </Heading>
    <p class="description">{description}</p>
    {meta && (
      <p class="meta">
        {date && <time datetime={isoDate(date)}>{formatDate(date)}</time>}
        {date && length && <span aria-hidden="true">·</span>}
        {length && <span>{length}</span>}
      </p>
    )}
    {topics.length > 0 && (
      <ul class="topics" aria-label="Topics">
        {topics.slice(0, 2).map((topic) => (
          <li>{topic}</li>
        ))}
      </ul>
    )}
    {source && (
      <p class="source">
        {source}
        {/* A no-break space keeps the mark with the source's last word. */}
        {"\u00a0"}
        <Icon name="external" />
      </p>
    )}
  </div>
</article>

<style>
  .content-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 1px 2px var(--color-shadow);
  }
  .content-card:hover {
    border-color: var(--color-accent);
  }
  .content-card:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .cover {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-background);
  }
  .cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 16px;
  }
  .body p {
    margin: 0;
  }
  .kind {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: balance;
  }
  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }
  /* The title's link covers the whole card. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .content-card:hover .title a {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }
  .description {
    color: var(--color-ink-muted);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .body .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin-top: auto;
    padding-top: 6px;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .topics li {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-ink);
    font-size: 12px;
  }
  .source {
    color: var(--color-ink-muted);
    font-size: 13px;
  }
  .source :global(.icon) {
    vertical-align: -0.125em;
  }
</style>
