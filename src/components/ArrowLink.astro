---
// A text link that leads on, such as "Get help" or "Explore the Hub": an
// arrow after it, or, for a link that leaves the site, the external mark
// and a note for screen readers.
//
// The link flows as text, so a long label wraps like a sentence and its
// icon stays beside the last word: a word joiner, held with the icon in a
// span that does not wrap, forbids a line break between the word and the
// icon. The label is trimmed, because a label written on its own line would
// otherwise end in a space before the icon.
import Icon from "./Icon.astro";

export interface Props {
  href: string;
  /** Whether the link leads to another site. */
  external?: boolean;
  /**
   * What the link is about, read only by screen readers after the label,
   * for a label that is the same on several links, such as "What the docs
   * say".
   */
  screenReaderContext?: string;
}

const { href, external = false, screenReaderContext } = Astro.props;
const labelHtml = (await Astro.slots.render("default")).trim();
const wordJoiner = "\u2060";
---

<a class="arrow-link" href={href}>
  <Fragment set:html={labelHtml} />
  {screenReaderContext && (
    <span class="sr-only">{`: ${screenReaderContext}`}</span>
  )}
  <span class="arrow-link-icon">
    {wordJoiner}
    <Icon name={external ? "external" : "arrow-right"} />
  </span>
  {external && <span class="sr-only">{" (external site)"}</span>}
</a>

<style>
  .arrow-link {
    color: var(--color-accent-strong);
    font-weight: 600;
    text-decoration: none;
  }
  .arrow-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .arrow-link-icon {
    white-space: nowrap;
  }
  .arrow-link :global(.icon) {
    margin-left: 6px;
    font-size: 15px;
    /* Levels the icon with the middle of the label's letters. */
    vertical-align: -0.15em;
  }
</style>
