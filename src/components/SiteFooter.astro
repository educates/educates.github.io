---
// The footer, the human site map: the brand, then Use cases, Features,
// Learn, Project and Elsewhere, and a copyright line. Six columns on wide
// screens; on tablets and phones the brand spans the width and the five
// link columns stack two by two.
import { footerColumns } from "../lib/navigation.ts";
import { site } from "../site.ts";

const columns = await footerColumns();
const year = new Date().getFullYear();
---

<footer class="site-footer" id="site-map">
  <div class="wrap">
    <div class="grid">
      <div class="about">
        <a class="brand" href="/">
          <img src="/img/logo.svg" alt="" width="30" height="30" />
          {site.name}
        </a>
        <p>Interactive workshop environments on Kubernetes.</p>
      </div>
      <nav class="columns" aria-label="Site map">
        {columns.map((column) => (
          <div>
            <h2>{column.label}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <p class="copyright">Copyright © {year} Educates Team.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 56px 32px;
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    font-size: 14px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 5fr);
    gap: 32px 28px;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px 28px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
  }
  .about p {
    max-width: 22em;
    margin: 12px 0 0;
    color: var(--color-ink-muted);
  }
  h2 {
    margin: 0 0 12px;
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 600;
  }
  ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: inline-block;
    padding-block: 3px;
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  li a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .copyright {
    margin: 40px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-muted);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    li a {
      padding-block: 6px;
    }
  }
</style>
