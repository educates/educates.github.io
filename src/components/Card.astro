---
// A card: a bordered surface panel, or a soft tinted one for a call to
// action such as "Support the project". The page styles what goes inside;
// other attributes, such as `id` or `class`, pass to the card itself.
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"div"> {
  /** "surface" for the page's cards, "soft" for a tinted call to action. */
  tone?: "surface" | "soft";
  /** The element to render, such as "li" for a card in a list. */
  as?: "div" | "li" | "article" | "section";
}

const {
  tone = "surface",
  as: Tag = "div",
  class: className,
  ...attributes
} = Astro.props;
---

<Tag class:list={["card", tone, className]} {...attributes}>
  <slot />
</Tag>

<style>
  .card {
    display: grid;
    gap: 12px;
    align-content: start;
    min-width: 0;
    padding: 24px;
    border-radius: var(--radius-card);
  }
  .surface {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  .soft {
    border: 1px solid transparent;
    background: var(--color-accent-soft);
  }
  @media (max-width: 640px) {
    .card {
      padding: 20px;
    }
  }
</style>
