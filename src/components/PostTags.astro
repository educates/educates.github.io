---
// A post's tags, each linking to the tag's page of posts.
import { tagPath, type Tag } from "../lib/posts.ts";

export interface Props {
  tags: Tag[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags" aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <a href={tagPath(tag)}>{tag.data.label}</a>
      </li>
    ))}
  </ul>
)}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: inline-block;
    padding: 4px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 14px;
    text-decoration: none;
  }
  a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }
</style>
