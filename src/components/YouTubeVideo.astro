---
// A YouTube video that loads nothing from Google until the reader presses
// play: the poster committed with the video's outside Content entry, a play
// button, and a one-line notice. Pressing play swaps in the player from
// youtube-nocookie.com; without JavaScript, the play button is a link to the
// video on YouTube. The video must have an outside Content entry, which
// gives its title and poster. MDX posts use it as
// <YouTubeVideo videoId="C6vCd6Nhf5M" />.
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { youTubeVideoId } from "../lib/outside-content.ts";

export interface Props {
  /** The video's id on YouTube, as in `watch?v=<id>`. */
  videoId: string;
  /**
   * Player parameters for the embed URL, as a query string, such as
   * `hl=en&cc_lang_pref=en&cc_load_policy=1` for English captions on.
   */
  params?: string;
}

const { videoId, params } = Astro.props;
const entry = (await getCollection("outsideContent")).find(
  (candidate) => youTubeVideoId(candidate.data.url) === videoId,
);
if (!entry) {
  throw new Error(
    `YouTubeVideo: video ${videoId} has no outside Content entry; add one under src/content/outside-content/`,
  );
}
const { title, poster, cover } = entry.data;
// A video from another channel has no poster; its `cover`, if any, stands in.
const image = poster ?? cover;

const embed = new URL(`https://www.youtube-nocookie.com/embed/${videoId}`);
for (const [name, value] of new URLSearchParams(params)) {
  embed.searchParams.set(name, value);
}
// The reader already pressed play once.
embed.searchParams.set("autoplay", "1");
---

<figure
  class="youtube-video"
  data-youtube-video
  data-embed={embed.href}
  data-title={title}
>
  <div class="frame">
    {image ? (
      <Image
        src={image}
        alt=""
        widths={[640, 1280]}
        sizes="(min-width: 860px) 760px, 100vw"
      />
    ) : (
      <span class="no-poster">{title}</span>
    )}
    <a class="play" href={entry.data.url} data-youtube-play>
      <span class="sr-only">Play video: {title}</span>
      <svg viewBox="0 0 64 64" width="64" height="64" aria-hidden="true">
        <circle cx="32" cy="32" r="32" />
        <path d="M26 20 46 32 26 44Z" />
      </svg>
    </a>
  </div>
  <figcaption>
    Playing loads this video from YouTube, and Google's privacy policy applies
    from then.
  </figcaption>
</figure>

<style>
  .youtube-video {
    margin: 0 0 1.4em;
  }
  .frame {
    position: relative;
    display: grid;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    background: var(--color-chrome);
  }
  .frame :global(img),
  .frame :global(iframe),
  .no-poster {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .frame :global(img) {
    object-fit: cover;
  }
  .no-poster {
    display: grid;
    place-items: end start;
    padding: 20px 24px;
    background-color: var(--color-background);
    background-image: radial-gradient(var(--color-line) 1px, transparent 1.5px);
    background-size: 14px 14px;
    color: var(--color-ink);
    font-size: 18px;
    font-weight: 600;
  }
  .play {
    display: grid;
    grid-area: 1 / 1;
    place-items: center;
  }
  /* The button sits on the poster, which looks the same in both themes, so
     its colours do not follow the theme. */
  .play svg {
    width: clamp(48px, 12%, 72px);
    height: auto;
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.35));
    transition: transform 0.15s;
  }
  .play circle {
    fill: #ffffff;
  }
  .play path {
    fill: #10203f;
  }
  .play:hover svg,
  .play:focus-visible svg {
    transform: scale(1.08);
  }
  .play:focus-visible {
    outline-offset: -4px;
  }
  figcaption {
    margin-top: 8px;
    color: var(--color-ink-muted);
    font-size: 14px;
  }
  @media (prefers-reduced-motion: reduce) {
    .play svg {
      transition: none;
    }
  }
</style>

<script>
  import { setUpYouTubeVideos } from "../scripts/youtube-video.ts";
  setUpYouTubeVideos();
</script>
