---
// Community: the team (the homepage's old `#team` anchor lands here), how
// to contribute, where to talk, and "Support the project" while the
// Sponsors setting is on.
import { Image } from "astro:assets";
import ArrowLink from "../components/ArrowLink.astro";
import Card from "../components/Card.astro";
import ProjectLayout from "../layouts/ProjectLayout.astro";
import { elsewhere } from "../lib/navigation.ts";
import {
  codeOfConductUrl,
  contributingUrl,
  issuesUrl,
  platformRepository,
  supportTheProject,
} from "../lib/project.ts";
import { team } from "../lib/team.ts";

const support = supportTheProject();
const youtubeHandle = new URL(elsewhere.youtube.href).pathname.slice(1);

const places = [
  {
    name: "Slack",
    text: "Questions, ideas and help, in the #educates channel on the Kubernetes Slack.",
    label: "Join the conversation",
    href: elsewhere.slack.href,
  },
  {
    name: "GitHub",
    text: "Issues, pull requests and releases for the platform, all in the open.",
    label: "View the repository",
    href: platformRepository,
  },
  {
    name: "YouTube",
    text: `Videos and talks about Educates on the ${youtubeHandle} channel.`,
    label: "Watch on YouTube",
    href: elsewhere.youtube.href,
  },
];
---

<ProjectLayout
  title="Community"
  description="The people behind Educates, how to contribute, and where to talk to us."
  lede="Educates is open source under Apache 2.0 and developed in the open on GitHub. Here is who builds it, how to join in, and where to find us."
>
  <section id="team" class="section" aria-labelledby="team-heading">
    <div class="wrap">
      <h2 id="team-heading">The team</h2>
      <p class="intro">The maintainers and contributors behind Educates.</p>
      <ul class="team">
        {team.map((member) => (
          <Card as="li" class="member">
            <Image
              class="photo"
              src={member.photo}
              alt=""
              width={96}
              height={96}
              densities={[1, 2]}
            />
            <div>
              <h3>{member.name}</h3>
              <p class="role">{member.role}</p>
            </div>
            <ul class="profiles">
              {member.profiles.map((profile) => (
                <li>
                  <a href={profile.href}>
                    {profile.site}
                    <span class="sr-only">{` profile of ${member.name}`}</span>
                  </a>
                </li>
              ))}
            </ul>
          </Card>
        ))}
      </ul>
    </div>
  </section>

  <section id="contribute" class="section" aria-labelledby="contribute-heading">
    <div class="wrap">
      <h2 id="contribute-heading">Contribute</h2>
      <div class="prose">
        <p>
          Bug reports, documentation fixes, answers to other people's questions
          and code all count. For anything bigger than a typo or an obvious bug
          fix, <a href={issuesUrl}>open an issue</a> first, so we can agree on
          the approach before you write it.
        </p>
        <p>
          Educates is designed so that many new needs can be met with what a
          workshop definition already offers, together with a Kubernetes
          operator of your own, without changing the core platform. Raising the
          idea early often saves you the pull request.
        </p>
      </div>
      <ul class="links">
        <li>
          <ArrowLink href={contributingUrl} external>
            Read the contributing guide
          </ArrowLink>
        </li>
        <li>
          <ArrowLink href={codeOfConductUrl} external>
            Read the code of conduct
          </ArrowLink>
        </li>
      </ul>
    </div>
  </section>

  <section id="talk" class="section" aria-labelledby="talk-heading">
    <div class="wrap">
      <h2 id="talk-heading">Where to talk</h2>
      <ul class="places">
        {places.map((place) => (
          <Card as="li">
            <h3>{place.name}</h3>
            <p>{place.text}</p>
            <ArrowLink href={place.href} external>
              {place.label}
            </ArrowLink>
          </Card>
        ))}
      </ul>
    </div>
  </section>

  {support && (
    <section id="support" class="section" aria-labelledby="support-heading">
      <div class="wrap">
        <Card tone="soft" class="support">
          <h2 id="support-heading">{support.title}</h2>
          <p>{support.text}</p>
          <ArrowLink href={support.href} external>
            {support.label}
          </ArrowLink>
        </Card>
      </div>
    </section>
  )}
</ProjectLayout>

<style>
  .section .wrap {
    padding-bottom: 40px;
  }
  /* A rule above each section, as wide as the content. */
  .section .wrap::before {
    content: "";
    display: block;
    margin-bottom: 40px;
    border-top: 1px solid var(--color-line);
  }
  .section:last-of-type .wrap {
    padding-bottom: 96px;
  }
  h2 {
    font-size: clamp(24px, 2.6vw, 30px);
  }
  h3 {
    font-size: 18px;
  }
  p {
    margin: 0;
    color: var(--color-ink-muted);
  }
  .intro {
    margin-top: 8px;
  }
  .team,
  .places {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .member {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 12px 18px;
  }
  .photo {
    grid-row: span 2;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-chrome);
  }
  .role {
    margin-top: 2px;
  }
  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .profiles a {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }
  .profiles a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }
  .prose {
    display: grid;
    gap: 12px;
    max-width: 44em;
    margin-top: 16px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .support {
    justify-items: start;
  }

  @media (max-width: 960px) {
    .team,
    .places {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
