---
import SessionDemo from "../components/SessionDemo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const lede =
  "Educates gives everyone their own live environment, with instructions beside a terminal, editor and Kubernetes console. Open source, running on your own Kubernetes cluster.";
---

<BaseLayout
  title="Hands-on workshops and demos, ready in one click"
  description={lede}
  cover={{ form: "session" }}
  stub
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Open source, Apache 2.0</p>
      <h1>Hands-on workshops and demos, ready in one click</h1>
      <p class="lede">{lede}</p>
      <div class="actions">
        <a class="button button-primary" href="/get-started">
          Get started
        </a>
        <a class="button button-secondary" href="https://hub.educates.dev">
          Explore the Hub
        </a>
      </div>
      <div class="demo">
        <SessionDemo />
        <p class="caption">
          Every Attendee gets this Session to themselves: slides, a terminal, an
          editor and a Kubernetes console beside the instructions. Click the
          tabs to look around.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero .wrap {
    padding-block: 72px 56px;
  }
  .eyebrow {
    display: inline-flex;
    margin: 0 0 18px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 14px;
    font-weight: 600;
  }
  h1 {
    max-width: 14em;
    font-size: clamp(36px, 4.6vw, 56px);
    line-height: 1.06;
    font-weight: 700;
  }
  .lede {
    max-width: 34em;
    margin: 20px 0 28px;
    color: var(--color-ink-muted);
    font-size: 18px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .demo {
    margin-top: 48px;
  }
  .caption {
    margin: 14px 0 0;
    color: var(--color-ink-muted);
    font-size: 14px;
  }
</style>
