---
// The Features overview: every Feature of the release the site describes,
// grouped by the job it serves. Each block shows the Feature's name, its
// sentence, its visual, its docs link and, for a flagship, a link to its
// deep page. Each job section and each block has an id to link to, such as
// `/features#delivering` or `/features#embedding`.
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeatureVisual from "../../components/FeatureVisual.astro";
import Icon from "../../components/Icon.astro";
import { breadcrumbs } from "../../lib/breadcrumbs.ts";
import { featurePath, features } from "../../lib/content.ts";
import { featuresByJob } from "../../lib/features.ts";

const title = "Features";
const description =
  "What Educates gives the people who write workshops, the people who run them, and the platform team that keeps them running.";
const groups = featuresByJob(await features());
---

<BaseLayout
  title={title}
  description={description}
  section="Feature"
  breadcrumbs={breadcrumbs("/features", title)}
>
  <div class="wrap intro">
    <h1>{title}</h1>
    <p class="lede">
      Everything here is something you can see or use in Educates, grouped by
      the job it serves. Each Feature links to its documentation, and the
      flagships have a page of their own.
    </p>
    <nav aria-label="Features by job">
      <ul class="jobs">
        {groups.map(({ job }) => (
          <li>
            <a href={`#${job.id}`}>{job.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  {groups.map(({ job, features }) => (
    <section class="job" id={job.id} aria-labelledby={`${job.id}-heading`}>
      <div class="wrap">
        <h2 id={`${job.id}-heading`}>{job.name}</h2>
        <p class="who">{job.who}</p>
        <ul class="features">
          {features.map((entry) => (
            <li class="feature" id={entry.id}>
              <FeatureVisual visual={entry.data.visual} />
              <div class="head">
                <h3>{entry.data.name}</h3>
                {entry.data.flagship && <span class="flag">Flagship</span>}
              </div>
              <p class="sentence">{entry.data.sentence}</p>
              <p class="links">
                {entry.data.flagship && (
                  <a href={featurePath(entry.id)}>
                    See it in depth
                    <span class="sr-only">{`: ${entry.data.name}`}</span>
                  </a>
                )}
                <a class="docs" href={entry.data.docs}>
                  Docs
                  <span class="sr-only">
                    {` for ${entry.data.name} (external site)`}
                  </span>
                  <Icon name="external" />
                </a>
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .intro {
    padding-block: 32px 8px;
  }
  h1 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
  }
  .lede {
    max-width: 38em;
    margin: 16px 0 24px;
    color: var(--color-ink-muted);
    font-size: 18px;
  }
  .jobs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jobs a {
    display: inline-flex;
    padding: 8px 14px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .jobs a:hover {
    border-color: var(--color-accent);
  }
  .job {
    padding-block: 48px;
    scroll-margin-top: 72px;
  }
  .job + .job {
    border-top: 1px solid var(--color-line);
  }
  h2 {
    font-size: clamp(26px, 3vw, 34px);
  }
  .who {
    max-width: 40em;
    margin: 8px 0 28px;
    color: var(--color-ink-muted);
  }
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    scroll-margin-top: 72px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }
  h3 {
    font-size: 19px;
    font-weight: 600;
  }
  .flag {
    padding: 4px 6px;
    border-radius: 5px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .sentence {
    flex: 1;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 15px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    font-weight: 600;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .docs :global(.icon) {
    font-size: 13px;
  }
</style>
