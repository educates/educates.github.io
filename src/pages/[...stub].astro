---
// Every stub page listed in src/stubs.ts.
import type { GetStaticPaths } from "astro";
import StubLayout from "../layouts/StubLayout.astro";
import { stubs } from "../stubs.ts";

export const getStaticPaths = (() =>
  stubs.map((stub) => ({
    params: { stub: stub.path.slice(1) },
    props: { stub },
  }))) satisfies GetStaticPaths;

const { stub } = Astro.props;
---

<StubLayout {...stub} />
