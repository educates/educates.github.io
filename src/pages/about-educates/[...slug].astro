---
// Every page of About Educates, from the about collection, in the docs
// layout: the section's pages in the sidebar, Architecture first at the
// section's own URL. The pages are concepts read in any order, so they have
// no previous and next links.
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { breadcrumbs } from "../../lib/breadcrumbs.ts";
import { aboutPages } from "../../lib/content.ts";
import { editUrl } from "../../lib/urls.ts";

export const getStaticPaths = (async () => {
  const { entries, section } = await aboutPages();
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry, section },
  }));
}) satisfies GetStaticPaths;

const { entry, section } = Astro.props;
const { Content, headings } = await render(entry);
const title = entry.data.title;
// Architecture is the section's own page, so its trail names the section
// without linking it.
const trail =
  entry.id === "index"
    ? [{ label: section.sidebar.label }, { label: title }]
    : breadcrumbs(section.href(entry.id), title);
---

<DocsLayout
  title={title}
  description={entry.data.description}
  section={section.sidebar.label}
  sidebar={section.sidebar}
  headings={headings}
  eyebrow={section.sidebar.label}
  editUrl={entry.filePath && editUrl(entry.filePath)}
  breadcrumbs={trail}
>
  <Content />
</DocsLayout>
