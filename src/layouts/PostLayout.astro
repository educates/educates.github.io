---
// A blog post's page: its title, date, reading time, authors and tags, the
// post itself, and a link to edit it on GitHub. A post with three or more
// headings has a table of contents beside it on wide screens. The cover is
// not shown.
import type { MarkdownHeading } from "astro";
import "../styles/prose.css";
import BaseLayout from "./BaseLayout.astro";
import PostAuthors from "../components/PostAuthors.astro";
import PostByline from "../components/PostByline.astro";
import PostTags from "../components/PostTags.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { breadcrumbs } from "../lib/breadcrumbs.ts";
import {
  postAuthors,
  postPath,
  postReadingMinutes,
  postTags,
  type Post,
} from "../lib/posts.ts";
import { postTableOfContents } from "../lib/table-of-contents.ts";
import { editUrl } from "../lib/urls.ts";

export interface Props {
  post: Post;
  /** The post's headings, as rendering the post returns them. */
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description } = post.data;
const [authors, tags] = await Promise.all([postAuthors(post), postTags(post)]);
const toc = postTableOfContents(headings);
---

<BaseLayout
  title={title}
  description={description}
  section="Blog post"
  cover={{
    form: "post",
    slug: post.id,
    minutes: postReadingMinutes(post),
    date: post.data.date,
  }}
  coverImage={post.data.cover}
  breadcrumbs={breadcrumbs(postPath(post), title)}
>
  <div class="wrap post" class:list={{ "has-toc": toc.length > 0 }}>
    <article>
      <header>
        <h1>{title}</h1>
        <PostByline post={post} />
        <PostAuthors authors={authors} />
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer>
        <PostTags tags={tags} />
        {post.filePath && (
          <a class="edit" href={editUrl(post.filePath)}>
            Edit this page
          </a>
        )}
      </footer>
    </article>
    {toc.length > 0 && <TableOfContents entries={toc} />}
  </div>
</BaseLayout>

<style>
  .post {
    max-width: calc(760px + 2 * var(--space-gutter));
    padding-block: 32px 80px;
  }
  /* The table of contents takes a column beside the post. */
  .post.has-toc {
    display: grid;
    grid-template-columns: minmax(0, 760px) 200px;
    gap: 48px;
    align-items: start;
    max-width: calc(760px + 48px + 200px + 2 * var(--space-gutter));
  }
  article {
    min-width: 0;
  }
  header {
    display: grid;
    gap: 16px;
    margin-bottom: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-line);
  }
  h1 {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }
  .edit {
    font-size: 15px;
    font-weight: 600;
  }

  /* Below wide screens the table of contents goes. */
  @media (max-width: 1200px) {
    .post.has-toc {
      grid-template-columns: minmax(0, 1fr);
      max-width: calc(760px + 2 * var(--space-gutter));
    }
  }
</style>
