---
// The layout of the site's docs sections, the Getting Started Guides and
// About Educates: the section's navigation on the left, the page in the
// middle, and a table of contents on the right on wide screens. Below the
// page: an edit link, and links to the previous and next pages when the
// section is a path. On phones the navigation collapses behind a button
// above the page, and the table of contents is left out.
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import "../styles/prose.css";
import type { Crumb } from "../lib/breadcrumbs.ts";
import type { PageCoverData } from "../lib/page-cover.ts";
import type { Sidebar, SidebarItem } from "../lib/sidebar.ts";
import { pagePath } from "../lib/urls.ts";

/** A link to a neighbouring page, with the page's title as its label. */
interface PagerLink {
  label: string;
  href: string;
}

export interface Props {
  /** The page's title, shown as its heading. */
  title: string;
  /** One or two sentences for search results and shared links. */
  description: string;
  /** The site section, such as "Getting Started Guides". */
  section: string;
  /** The section's navigation; the current page is marked in it. */
  sidebar: Sidebar;
  /**
   * The page's headings, as rendering a content entry returns them. Its
   * second and third level headings make the table of contents.
   */
  headings?: MarkdownHeading[];
  /** A short line above the title, such as where the page sits in a path. */
  eyebrow?: string;
  /** The pages before and after this one, for a section read in order. */
  pager?: { previous?: PagerLink; next?: PagerLink };
  /** Where to edit the page's source, from `editUrl()` in src/lib/urls.ts. */
  editUrl?: string;
  /** The breadcrumb trail, from `breadcrumbs()` in src/lib/breadcrumbs.ts. */
  breadcrumbs?: Crumb[];
  /** What the page declares about its cover; see the base layout. */
  cover?: PageCoverData;
}

const {
  title,
  description,
  section,
  sidebar,
  headings = [],
  eyebrow,
  pager,
  editUrl,
  breadcrumbs,
  cover,
} = Astro.props;

const current = pagePath(Astro.url.pathname);
const ariaCurrent = (href: string) => (href === current ? "page" : undefined);
const contains = (item: SidebarItem): boolean =>
  item.href === current || (item.items ?? []).some(contains);

// Second level headings, each with the third level headings under it.
interface TocEntry {
  heading: MarkdownHeading;
  children: MarkdownHeading[];
}
const toc: TocEntry[] = [];
for (const heading of headings) {
  if (heading.depth === 2) toc.push({ heading, children: [] });
  else if (heading.depth === 3) toc.at(-1)?.children.push(heading);
}
---

<BaseLayout
  title={title}
  description={description}
  section={section}
  cover={cover}
  breadcrumbs={breadcrumbs}
>
  <div class="wrap docs" class:list={{ "has-toc": toc.length > 0 }}>
    <nav class="docs-nav" aria-label={sidebar.label} data-docs-nav>
      <button
        class="docs-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="docs-nav-list"
        data-docs-nav-toggle
      >
        {sidebar.label}
        <Icon name="chevron-down" />
      </button>
      <div class="docs-nav-list" id="docs-nav-list">
        <a
          class="docs-nav-heading"
          href={sidebar.href}
          aria-current={ariaCurrent(sidebar.href)}
        >
          {sidebar.label}
        </a>
        <ul>
          {sidebar.items.map((item) => (
            <li class:list={{ "is-open": contains(item) }}>
              <a href={item.href} aria-current={ariaCurrent(item.href)}>
                {item.marker && <span class="marker">{item.marker}</span>}
                {item.label}
              </a>
              {item.items && (
                <ul>
                  {item.items.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={ariaCurrent(child.href)}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <article class="docs-page">
      <header>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
      </header>
      <div class="prose">
        <slot />
      </div>
      {editUrl && (
        <p class="edit">
          <a href={editUrl}>
            <Icon name="github" />
            Edit this page on GitHub
          </a>
        </p>
      )}
      {pager && (pager.previous || pager.next) && (
        <nav class="pager" aria-label="Previous and next pages">
          {pager.previous && (
            <a class="previous" href={pager.previous.href} rel="prev">
              <span class="pager-label">Previous</span>
              {pager.previous.label}
            </a>
          )}
          {pager.next && (
            <a class="next" href={pager.next.href} rel="next">
              <span class="pager-label">Next</span>
              {pager.next.label}
            </a>
          )}
        </nav>
      )}
    </article>

    {toc.length > 0 && (
      <nav class="docs-toc" aria-labelledby="docs-toc-heading">
        <h2 id="docs-toc-heading">On this page</h2>
        <ul>
          {toc.map(({ heading, children }) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
              {children.length > 0 && (
                <ul>
                  {children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</BaseLayout>

<script>
  import { setUpDocsNav } from "../scripts/docs-nav.ts";
  setUpDocsNav();
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
    padding-block: 28px 96px;
  }
  .docs.has-toc {
    grid-template-columns: 240px minmax(0, 1fr) 200px;
  }

  /* Section navigation */
  .docs-nav {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    font-size: 15px;
  }
  .docs-nav-toggle {
    display: none;
  }
  .docs-nav-heading {
    display: block;
    margin-bottom: 8px;
    padding: 6px 10px;
    color: var(--color-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .docs-nav-heading[aria-current="page"] {
    color: var(--color-accent-strong);
  }
  .docs-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs-nav li + li {
    margin-top: 2px;
  }
  .docs-nav a:not(.docs-nav-heading) {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 6px 10px;
    border-radius: var(--radius-control);
    color: var(--color-ink-muted);
    line-height: 1.35;
    text-decoration: none;
  }
  .docs-nav a:hover {
    color: var(--color-ink);
  }
  .docs-nav li a[aria-current="page"] {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-weight: 600;
  }
  .docs-nav ul ul {
    margin: 2px 0 6px 21px;
    padding-left: 10px;
    border-left: 1px solid var(--color-line);
  }
  .marker {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-ink);
    font: 600 12px/1 var(--font-mono);
    transform: translateY(-1px);
  }
  .is-open > a .marker,
  [aria-current="page"] .marker {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  /* The page */
  .docs-page {
    min-width: 0;
    max-width: 760px;
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--color-accent-strong);
    font: 600 13px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin-bottom: 24px;
    font-size: clamp(30px, 3.6vw, 42px);
    font-weight: 700;
  }
  .edit {
    margin: 48px 0 0;
    font-size: 15px;
  }
  .edit a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-ink-muted);
  }
  .edit a:hover {
    color: var(--color-ink);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 18px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .pager a:hover {
    border-color: var(--color-accent);
  }
  .pager .next {
    grid-column: 2;
    text-align: right;
  }
  .pager-label {
    color: var(--color-ink-muted);
    font-size: 13px;
    font-weight: 500;
  }

  /* Table of contents */
  .docs-toc {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    font-size: 14px;
  }
  .docs-toc h2 {
    margin-bottom: 10px;
    color: var(--color-ink);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .docs-toc ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs-toc li {
    margin-top: 6px;
  }
  .docs-toc ul ul {
    padding-left: 12px;
  }
  .docs-toc a {
    color: var(--color-ink-muted);
    text-decoration: none;
  }
  .docs-toc a:hover {
    color: var(--color-ink);
  }

  /* Below wide screens the table of contents goes. */
  @media (max-width: 1200px) {
    .docs.has-toc {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .docs-toc {
      display: none;
    }
  }

  /* Phones: the navigation sits above the page, behind a button. */
  @media (max-width: 960px) {
    .docs,
    .docs.has-toc {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 16px;
    }
    .docs-nav {
      position: static;
      max-height: none;
      overflow: visible;
      border: 1px solid var(--color-line);
      border-radius: var(--radius-card);
      background: var(--color-surface);
    }
    .docs-nav-list {
      padding: 4px 12px 12px;
    }
    .docs-nav-heading {
      display: none;
    }
    :global(html.js) .docs-nav-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 48px;
      padding: 10px 16px;
      border: 0;
      background: none;
      color: var(--color-ink);
      font: inherit;
      font-weight: 600;
      cursor: pointer;
    }
    :global(html.js) .docs-nav-toggle :global(.icon) {
      transition: transform 0.15s ease;
    }
    :global(html.js) .docs-nav[data-open] .docs-nav-toggle :global(.icon) {
      transform: rotate(180deg);
    }
    :global(html.js) .docs-nav:not([data-open]) .docs-nav-list {
      display: none;
    }
    :global(html:not(.js)) .docs-nav-heading {
      display: block;
      padding-top: 12px;
    }
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }
    .pager .next {
      grid-column: 1;
    }
  }
</style>
