{
  "name": "educates-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run site-check",
    "preview": "astro preview",
    "check": "astro check",
    "site-check": "node scripts/site-check/cli.ts dist",
    "link-check": "lychee --offline --root-dir \"$PWD/dist\" 'dist/**/*.html'",
    "docker-build": "sh scripts/docker-build.sh",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,mjs,css}\"",
    "test": "vitest run",
    "posters": "node scripts/posters/cli.ts",
    "url-check": "node scripts/url-check/cli.ts",
    "captures": "node scripts/captures/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.7",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "asciinema-player": "^3.18.0",
    "astro": "^7.4.8",
    "astro-expressive-code": "^0.44.3",
    "astro-mermaid": "^2.2.0",
    "feed": "^6.0.0",
    "mermaid": "^11.17.2",
    "node-html-parser": "^9.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "0.63.2",
    "satteri": "^0.11.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "volta": {
    "node": "26.10.0"
  }
}
