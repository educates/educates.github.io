{
  "name": "educates-dev",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run site-check",
    "preview": "astro preview",
    "check": "astro check",
    "site-check": "node scripts/site-check/cli.ts dist",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,mjs,css}\"",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "volta": {
    "node": "26.10.0"
  }
}
